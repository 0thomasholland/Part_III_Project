        <PAGEOBJECT XPOS="201.563585277786" YPOS="479.265509963493" OwnPage="0" ItemID="1619587088" PTYPE="4" WIDTH="1031.61752401907" HEIGHT="304" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L1031.62 0 L1031.62 304 L0 304 L0 0 Z" copath="M0 0 L1031.62 0 L1031.62 304 L0 304 L0 0 Z" gXpos="201.563585277786" gYpos="479.265509963493" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="2" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style"/>
                <ITEXT CH="Global Sea Level Change Estimation is an important climate quantity:"/>
                <para PARENT="Default Paragraph Style" ParagraphEffectIndent="1"/>
                <ITEXT CH="Global Mean Sea Level (GMSL) rise is a key metric for validating climate models"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Attribution: accurate partitioning of sea level rise between thermal expansion, ice sheets, and glaciers is essential"/>
                <para ALIGN="0" ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Critical decisions (e.g. 1.5°C targets, coastal defences) depend on crossing specific sea level thresholds. Biased estimates could trigger premature or delayed responses."/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
            </StoryText>
        </PAGEOBJECT>
