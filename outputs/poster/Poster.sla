        <PAGEOBJECT XPOS="185.04" YPOS="514.277327318861" OwnPage="0" ItemID="1762422804" PTYPE="4" WIDTH="1010.37546036123" HEIGHT="635.049150409481" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L1010.38 0 L1010.38 635.049 L0 635.049 L0 0 Z" copath="M0 0 L1010.38 0 L1010.38 635.049 L0 635.049 L0 0 Z" gXpos="185.04" gYpos="514.277327318861" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="3" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style"/>
                <ITEXT CH="Importance of Sea Level Estimates:"/>
                <para PARENT="Default Paragraph Style" ParagraphEffectIndent="1"/>
                <ITEXT CH="GMSL rise is a key integrated metric for validating climate models"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Provides constraints on ice sheet melt locations for other models"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Attribution: accurate partitioning of sea level rise between thermal expansion, ice sheets, and glaciers is essential"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Reducing Biases is Critical:"/>
                <para/>
                <ITEXT CH="Limited satellite coverage: Altimeters only observe ±66° latitude, missing polar regions where ice melt signals are strongest (Greenland, Antarctica) and where sea level &quot;fingerprints&quot; have distinct spatial patterns."/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Policy-relevant thresholds: Critical decisions (e.g., 1.5°C targets, coastal adaptation triggers) depend on crossing specific sea level thresholds. Biased estimates could trigger premature or delayed responses."/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
            </StoryText>
        </PAGEOBJECT>
