        <PAGEOBJECT XPOS="2900.50090779115" YPOS="479.265509963493" OwnPage="0" ItemID="1560480784" PTYPE="4" WIDTH="456.65127754896" HEIGHT="769.510642341329" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L456.651 0 L456.651 769.511 L0 769.511 L0 0 Z" copath="M0 0 L456.651 0 L456.651 769.511 L0 769.511 L0 0 Z" gXpos="2900.50090779115" gYpos="479.265509963493" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="2" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style"/>
                <ITEXT CH="Implement a Bayesian Inversion Method:"/>
                <para PARENT="Default Paragraph Style" ParagraphEffectIndent="1"/>
                <ITEXT CH="Initially considering 30 day averaged bins"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Method has been shown to work "/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <para/>
                <ITEXT CH="Possible extensions:"/>
                <para/>
                <ITEXT CH="Extend to time-dependent estimates"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Consider feed-forward mechanisms (Kalman filter-like approaches)"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Integration of ice altimetry data and other data types"/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <ITEXT CH="GMSL / Local SL change attribution to "/>
                <para ParagraphEffectOffset="11.3385826771654" ParagraphEffectIndent="1" DROP="0" Bullet="1" BulletStr="•" Numeration="0"/>
                <para/>
                <ITEXT CH="Project is viewable"/>
                <para/>
                <ITEXT CH="on Github:"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
