@unpublished{heathcoteScaleableBayesianFramework2026,
  title = {A Scaleable {{Bayesian}} Framework for Modern Sea Level Inference},
  author = {Heathcote, D A and Al-Attar, D},
  date = {2026},
  abstract = {This paper presents a scalable Bayesian framework for the inference of modern-day sea level change, focusing on the use of time-dependent satellite gravity observations to constrain mass redistribution in ice sheets and the oceans. While the determination of surface loads from gravity data typically relies on the method of Wahr et al. (1998) and its later refinements, it has been previously shown that this approach introduces systematic errors of approximately 5–15 per cent by failing to account for induced water loads and gravitationally self-consistent sea level change (e.g. Riva et al. 2010; Sterenborg et al. 2013). Motivated by such issues, we describe a new inference framework that offers three key advances over previous studies. First, we utilise recent developments in adjoint sea level fingerprints to incorporate the physics of self-attraction and loading into both forward and inverse modelling. Second, we solve the full Bayesian inverse problem in an infinite-dimensional setting following Stuart (2010) and thereby avoid the underestimation of uncertainties that is inherent within finite-dimensional approximations. Finally, our method is designed for the flexible integration of multiple data types, and is therefore compatible with tide gauge records and satellite altimetry in joint inversions.},
  howpublished = {Unpublished Draft, via Personal Communication},
  langid = {english},
  file = {/Users/th/Zotero/storage/GXMTVM94/Heathcote and Al-Attar - A scaleable Bayesian framework for modern sea level inference.pdf}
}

@article{hortonMappingSeaLevelChange2018,
